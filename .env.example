# Copie este arquivo para .env e ajuste apenas o necessário.
PONTOATIVO_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PONTOATIVO_CHROMA_COLLECTION=pontoativo_documentos
PONTOATIVO_PARENT_CHUNK_TOKENS=450
PONTOATIVO_CHUNK_OVERLAP_TOKENS=50
PONTOATIVO_EMBEDDING_SEGMENT_TOKENS=120
PONTOATIVO_TOP_K=4
PONTOATIVO_OLLAMA_BASE_URL=http://127.0.0.1:11434
PONTOATIVO_OLLAMA_MODEL=gemma4:26b
# Com pouca memória de GPU (ex.: Mac M4 de 24 GB), use gemma4:12b.
# Modelo só da barra do mapa, que apenas classifica a pergunta. Um modelo menor
# deixa a busca no mapa mais rápida; vazio usa o mesmo de PONTOATIVO_OLLAMA_MODEL.
# Escolha com: python -m pontoativo_rag.rotas --modelos <modelo1> <modelo2>
PONTOATIVO_OLLAMA_MODEL_MAPA=
PONTOATIVO_OLLAMA_TIMEOUT=180
# Contexto e tamanho máximo da resposta; valores menores aceleram a geração.
PONTOATIVO_OLLAMA_NUM_CTX=8192
PONTOATIVO_OLLAMA_NUM_PREDICT=400
# Tempo que o Ollama mantém o modelo carregado entre perguntas.
PONTOATIVO_OLLAMA_KEEP_ALIVE=10m
# 1: o modelo responde em JSON com as fontes de cada frase; 0: texto livre.
PONTOATIVO_RESPOSTA_ESTRUTURADA=1
# Total de chamadas ao modelo por pergunta, incluindo revisões.
PONTOATIVO_TENTATIVAS_GERACAO=3
PONTOATIVO_MAX_DISTANCE=0.45
